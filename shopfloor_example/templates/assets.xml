<odoo>
    <template
        id="shopfloor_app_assets"
        inherit_id="shopfloor_mobile_base.shopfloor_app_assets"
    >
        <!--
        NOTE: to replace an existing module (eg: a scenario) do not replace its tag,
        override `shopfloor.app._get_app_js_overrides` instead.
        -->
        <t id="new_scenario_hook" position="before">
            <script id="script_detail_partner" type="module">
                import "/shopfloor_example/static/src/components/detail/detail_partner.esm.js";
            </script>
            <script id="script_scenario_partner" type="module">
                import "/shopfloor_example/static/src/scenario/partner.esm.js";
            </script>
            <script id="script_detail_country" type="module">
                import "/shopfloor_example/static/src/components/detail/detail_country.esm.js";
            </script>
            <script id="script_scenario_country" type="module">
                import "/shopfloor_example/static/src/scenario/country.esm.js";
            </script>
        </t>
    </template>
    <template
        id="shopfloor_app_demo_assets"
        inherit_id="shopfloor_mobile_base.shopfloor_app_demo_assets"
    >
        <xpath expr="//script[last()]" position="after">
            <script id="script_demo_example" type="module">
                import "/shopfloor_example/static/src/demo/demo.example.esm.js";
            </script>
        </xpath>
    </template>
</odoo>
