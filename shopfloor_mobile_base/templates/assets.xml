<odoo>
    <!--
    How to load files (see readme/USAGE.md "Assets" for details):

    * ES modules: use an inline module importing the plain URL (no version),
      the import map takes care of versioning and overrides:

        <script id="script_foo" type="module">
            import "/my_module/static/src/foo.esm.js";
        </script>

      Do not use `src` for ES modules: the import map does not apply to it.
      Modules imported by other modules do not need a tag at all.

    * classic scripts and stylesheets: use `static_url` to get a versioned URL:

        <link t-att-href="static_url('/my_module/static/src/foo.css')" rel="stylesheet" />
    -->
    <template id="shopfloor_app_assets" name="Shopfloor app assets">
        <!-- Styles  -->
        <link
            id="link_css_gfonts_roboto"
            t-att-href="static_url('/shopfloor_mobile_base/static/src/css/vendor/google-fonts-roboto.css')"
            rel="stylesheet"
        />
        <link
            id="link_css_materialdesignicons"
            t-att-href="static_url('/shopfloor_mobile_base/static/src/lib/materialdesign-icons/css/materialdesignicons.min.css')"
            rel="stylesheet"
        />
        <link
            id="link_css_vuetify"
            t-att-href="static_url('/shopfloor_mobile_base/static/src/lib/vuetify/vuetify.min.css')"
            rel="stylesheet"
        />
        <link
            id="link_css_main"
            t-att-href="static_url('/shopfloor_mobile_base/static/src/css/main.css')"
            rel="stylesheet"
        />
        <!-- External libs -->
        <script
            id="script_jquery"
            t-att-src="static_url('/shopfloor_mobile_base/static/src/lib/jquery-3.4.1.slim.min.js')"
        />
        <script
            id="script_lodash"
            t-att-src="static_url('/shopfloor_mobile_base/static/src/lib/lodash.min.js')"
        />
        <script
            t-if="not debug"
            id="script_vue_min"
            t-att-src="static_url('/shopfloor_mobile_base/static/src/lib/vue.min.js')"
        />
        <script
            t-if="debug"
            id="script_vue"
            t-att-src="static_url('/shopfloor_mobile_base/static/src/lib/vue.js')"
        />
        <script
            id="script_vue_router"
            t-att-src="static_url('/shopfloor_mobile_base/static/src/lib/vue-router.min.js')"
        />
        <!-- https://yarkovaleksei.github.io/vue2-storage/en -->
        <script id="script_vue_storage" type="module">
            import "/shopfloor_mobile_base/static/src/lib/vue2-storage.min.js";
        </script>
        <script
            id="script_vue_vuetify"
            t-att-src="static_url('/shopfloor_mobile_base/static/src/lib/vuetify/vuetify.min.js')"
        />
        <script
            id="script_vue_i18n"
            t-att-src="static_url('/shopfloor_mobile_base/static/src/lib/vue-i18n.min.js')"
        />
        <!-- Custom services, utils, generic scripts -->
        <script
            id="script_fetch"
            t-att-src="static_url('/shopfloor_mobile_base/static/src/fetch.js')"
        />
        <script id="script_i18n_translation_en" type="module">
            import "/shopfloor_mobile_base/static/src/i18n/i18n.en.esm.js";
        </script>
        <script id="script_i18n_translation_fr" type="module">
            import "/shopfloor_mobile_base/static/src/i18n/i18n.fr.esm.js";
        </script>
        <script id="script_i18n_translation_de" type="module">
            import "/shopfloor_mobile_base/static/src/i18n/i18n.de.esm.js";
        </script>
        <script id="script_utils" type="module">
            import "/shopfloor_mobile_base/static/src/utils.esm.js";
        </script>
        <script id="script_page_home" type="module">
            import "/shopfloor_mobile_base/static/src/homepage.esm.js";
        </script>
        <script id="script_page_login" type="module">
            import "/shopfloor_mobile_base/static/src/loginpage.esm.js";
        </script>
        <script id="script_page_language" type="module">
            import "/shopfloor_mobile_base/static/src/settings/language.esm.js";
        </script>
        <script id="script_page_profile" type="module">
            import "/shopfloor_mobile_base/static/src/settings/profile.esm.js";
        </script>
        <!-- Global/generic components -->
        <script id="script_component_screen" type="module">
            import "/shopfloor_mobile_base/static/src/components/screen.esm.js";
        </script>
        <script id="script_component_report_issue" type="module">
            import "/shopfloor_mobile_base/static/src/components/report_issue.esm.js";
        </script>
        <script id="script_component_misc" type="module">
            import "/shopfloor_mobile_base/static/src/components/misc.esm.js";
        </script>
        <script id="script_component_list" type="module">
            import "/shopfloor_mobile_base/static/src/components/list.esm.js";
        </script>
        <script id="script_component_manual_select" type="module">
            import "/shopfloor_mobile_base/static/src/components/manual_select.esm.js";
        </script>
        <script id="script_component_input_number_spinner" type="module">
            import "/shopfloor_mobile_base/static/src/components/input-number-spinner.esm.js";
        </script>
        <script id="script_component_priority_widget" type="module">
            import "/shopfloor_mobile_base/static/src/components/priority-widget.esm.js";
        </script>
        <script id="script_component_detail_card" type="module">
            import "/shopfloor_mobile_base/static/src/components/detail/detail_card.esm.js";
        </script>
        <script id="script_component_searchbar" type="module">
            import "/shopfloor_mobile_base/static/src/components/searchbar/searchbar.esm.js";
        </script>
        <script id="script_component_list_filter" type="module">
            import "/shopfloor_mobile_base/static/src/components/searchbar/list_filter.esm.js";
        </script>
        <script id="script_component_datepicker" type="module">
            import "/shopfloor_mobile_base/static/src/components/datepicker/date_picker.esm.js";
        </script>
        <!-- These 2 are not ES modules -->
        <script
            id="script_component_user_confirmation"
            t-att-src="static_url('/shopfloor_mobile_base/static/src/components/userConfirmation/userConfirmation.esm.js')"
        />
        <script
            id="script_component_user_information"
            t-att-src="static_url('/shopfloor_mobile_base/static/src/components/userInformation/userInformation.esm.js')"
        />
        <script id="script_scenario_scan_anything" type="module">
            import "/shopfloor_mobile_base/static/src/scenario/scan_anything.esm.js";
        </script>
        <script id="script_scenario_form" type="module">
            import "/shopfloor_mobile_base/static/src/scenario/form.esm.js";
        </script>
        <script id="script_theme" type="module">
            import "/shopfloor_mobile_base/static/src/theme.esm.js";
        </script>

        <t
            id="new_scenario_hook"
            t-if="0"
        >Hook to this element to inject your own scenario</t>

        <script id="script_devtools" t-if="debug or app_info.demo_mode">
            Vue.config.devtools = true
        </script>
        <!-- Main app script -->
        <script id="script_app_main" type="module">
            import "/shopfloor_mobile_base/static/src/main.esm.js";
        </script>
    </template>
    <template id="shopfloor_app_demo_assets" name="Shopfloor app demo assets">
        <script id="script_demo_core" type="module">
            import "/shopfloor_mobile_base/static/src/demo/demo.core.esm.js";
        </script>
        <!--
        TODO add demo data for non wms stuff
        <script id="script_demo_scan_anything" type="module">
            import "/shopfloor_mobile_base/static/src/demo/demo.scan_anything.esm.js";
        </script>
        -->
    </template>
</odoo>
